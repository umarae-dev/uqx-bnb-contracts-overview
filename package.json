{
  "name": "uqx-bnb-contracts",
  "version": "1.0.0",
  "private": true,
  "description": "Open-source UQX smart contracts and production-derived Hardhat test suite for BNB Smart Chain",
  "license": "MIT",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test test/uqx/*.test.js",
    "test:uqx": "hardhat test test/uqx/*.test.js",
    "deploy:safecore": "hardhat run scripts/deploy-safecore-v4.js",
    "relayer:check": "node --check relayer/server.js && node --check relayer/server-v4_1.js && node --check relayer/healthcheck.js",
    "relayer:start": "node relayer/server.js",
    "check:public": "node scripts/check-public-repo.js",
    "clean": "hardhat clean"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "ethers": "6.15.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "2.1.2",
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "1.1.2",
    "@openzeppelin/contracts": "4.9.6",
    "chai": "4.5.0",
    "hardhat": "2.29.0"
  }
}
