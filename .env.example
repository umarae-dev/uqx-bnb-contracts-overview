# Copy to .env only for your own deployment/inspection environment.
# NEVER commit real private keys, seed phrases, RPC credentials, or treasury secrets.

# Optional RPC overrides. Public fallbacks are used when these are empty.
BSC_DEPLOY_RPC_URL=
BSC_TESTNET_RPC_URL=

# Deployment signer. Use a dedicated wallet; never commit the real value.
PAYMASTER_DEPLOYER_PRIVATE_KEY=

# UQX deployment/governance addresses.
UQX_TREASURY_ADDRESS=
UQX_MULTISIG_ADDRESS=
UQX_TIMELOCK_DELAY_SECONDS=172800
UQX_TOKEN_ADDRESS=
UQX_VESTING_ADDRESS=
UQX_TIMELOCK_ADDRESS=
UQX_PRESALE_ADDRESS=

# Inspection utilities.
TOKEN_ADDRESS=
TX_HASH=
