# Copy to .env only for your own deployment/inspection environment.
# NEVER commit real private keys, seed phrases, RPC credentials, or treasury secrets.

# Optional RPC overrides. Public fallbacks are used when these are empty.
BSC_DEPLOY_RPC_URL=
BSC_TESTNET_RPC_URL=

# Existing UQX deployment signer. Use a dedicated wallet; never commit the real value.
PAYMASTER_DEPLOYER_PRIVATE_KEY=

# SafeCore V4 factory deployment.
# Default SAFECORE_NETWORK is bscTestnet. Keep the deployer key local only.
SAFECORE_NETWORK=bscTestnet
SAFECORE_DEPLOYER_PRIVATE_KEY=
# Mainnet deployment stays blocked while the contract is not independently audited.
# Set this locally ONLY after a genuine external audit is complete.
SAFECORE_MAINNET_AUDIT_ACK=

# UQX deployment/governance addresses.
UQX_TREASURY_ADDRESS=
UQX_MULTISIG_ADDRESS=
UQX_TIMELOCK_DELAY_SECONDS=172800
UQX_TOKEN_ADDRESS=
UQX_VESTING_ADDRESS=
UQX_TIMELOCK_ADDRESS=
UQX_PRESALE_ADDRESS=

# Public SafeCore deployment outputs/config (never put a private key here).
SAFECORE_FACTORY_ADDRESS=
SAFECORE_RELAYER_BASE_URL=

# Isolated SafeCore relayer runtime. The relayer key pays gas only; it is not
# a SafeCore authority and must never be reused as a user/device/recovery key.
SAFECORE_RPC_URL=
SAFECORE_CHAIN_ID=56
SAFECORE_RELAYER_PRIVATE_KEY=
SAFECORE_RELAYER_MAX_GAS=1200000
SAFECORE_RELAYER_RATE_LIMIT=30
PORT=8787

# Inspection utilities.
TOKEN_ADDRESS=
TX_HASH=
