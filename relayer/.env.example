# PUBLIC deployment binding
SAFECORE_CHAIN_ID=56
SAFECORE_RPC_URL=https://bsc-rpc.publicnode.com
SAFECORE_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000

# PRIVATE runtime secret. Never commit a real value.
SAFECORE_RELAYER_PRIVATE_KEY=0xREPLACE_IN_PRIVATE_RUNTIME_ONLY

# HTTP/runtime limits
PORT=8787
SAFECORE_RELAYER_MAX_GAS=1200000
SAFECORE_RELAYER_RATE_LIMIT=30
SAFECORE_RELAYER_MAX_PENDING=64

# Keep false unless the relayer is directly behind a trusted reverse proxy that
# strips untrusted forwarding headers and writes its own X-Forwarded-For value.
SAFECORE_TRUST_PROXY=false
